{
  "schemaVersion": 1,
  "name": "SUPERZ",
  "id": "superz",
  "version": "${version}",
  "description": "SUPERZ Hack Client / Utility Mod - a Dragon Ball Z inspired, GPL-3.0 derivative of Meteor Client.",
  "authors": [
    "MineGame159",
    "squidoodly",
    "seasnail",
    "Meteor Development (upstream Meteor Client)",
    "SUPERZ project (modifications)"
  ],
  "contact": {
    "homepage": "https://github.com/MeteorDevelopment/meteor-client",
    "issues": "https://github.com/MeteorDevelopment/meteor-client/issues",
    "sources": "https://github.com/MeteorDevelopment/meteor-client",
    "discord": "https://meteorclient.com/discord"
  },
  "license": "GPL-3.0",
  "icon": "assets/superz/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "meteordevelopment.meteorclient.MeteorClient"
    ],
    "modmenu": [
      "meteordevelopment.meteorclient.modintegration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "superz.mixins.json",
    "superz-baritone.mixins.json",
    "superz-indigo.mixins.json",
    "superz-sodium.mixins.json",
    "superz-lithium.mixins.json",
    "superz-viafabricplus.mixins.json"
  ],
  "accessWidener": "superz.accesswidener",
  "custom": {
    "superz:build_number": "${build_number}",
    "superz:color": "255,170,40",
    "superz:commit": "${commit}",
    "superz:modified_from": "Meteor Client (https://github.com/MeteorDevelopment/meteor-client), GPL-3.0",
    "modmenu": {
      "links": {
        "modmenu.discord": "https://meteorclient.com/discord"
      }
    },
    "badoptimizations:cache_hooks": {
      "lightmap": "meteordevelopment.meteorclient.modintegration.BadOptimizationsHook"
    }
  },
  "depends": {
    "java": ">=21",
    "minecraft": ["${minecraft_version}"],
    "fabricloader": ">=${loader_version}"
  },
  "breaks": {
    "optifabric": "*",
    "feather": "*",
    "origins": "*",
    "sodium": "<0.8.7",
    "morechathistory": "*",
    "lithium": "<0.21.3",
    "meteor-client": "*"
  }
}
